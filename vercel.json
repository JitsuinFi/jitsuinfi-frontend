{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/node/:path*",
      "has": [
        {
          "type": "host",
          "value": "jitsuinfi-console-demo.vercel.app"
        }
      ],
      "destination": "https://financier-node-demo-production.up.railway.app/node/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jitsuinfi-console-demo.vercel.app"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/node/:path*",
      "has": [
        {
          "type": "host",
          "value": "jitsuinfi-console.vercel.app"
        }
      ],
      "destination": "https://financier-node-production.up.railway.app/node/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jitsuinfi-console.vercel.app"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/api/board",
      "destination": "https://financier-node-production.up.railway.app/node/board"
    },
    {
      "source": "/api/:path*",
      "destination": "https://relay-production-27dc.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!api/|node/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "jitsuinfi-console-demo.vercel.app"
        }
      ],
      "destination": "/console",
      "permanent": false
    },
    {
      "source": "/(index.html|app.html)",
      "has": [
        {
          "type": "host",
          "value": "jitsuinfi-console-demo.vercel.app"
        }
      ],
      "destination": "/console",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "jitsuinfi-console.vercel.app"
        }
      ],
      "destination": "/console",
      "permanent": false
    },
    {
      "source": "/(index.html|app.html)",
      "has": [
        {
          "type": "host",
          "value": "jitsuinfi-console.vercel.app"
        }
      ],
      "destination": "/console",
      "permanent": false
    },
    {
      "source": "/console.html",
      "missing": [
        {
          "type": "host",
          "value": "jitsuinfi-console.vercel.app"
        }
      ],
      "has": [
        {
          "type": "host",
          "value": "jitsuinfi.vercel.app"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/console/:path*",
      "has": [
        {
          "type": "host",
          "value": "jitsuinfi.vercel.app"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/console",
      "has": [
        {
          "type": "host",
          "value": "jitsuinfi.vercel.app"
        }
      ],
      "destination": "/",
      "permanent": false
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
